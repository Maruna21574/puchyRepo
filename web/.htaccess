# ---------------------------------------------------------------
# Masáže v Sásovej – konfigurácia Apache (Websupport)
# ---------------------------------------------------------------

DirectoryIndex index.php
Options -Indexes
AddDefaultCharset UTF-8
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Presmerovanie na HTTPS (zapnite po aktivácii SSL certifikátu na Websupporte)
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Dynamická sitemap a robots.txt (doména sa doplní automaticky)
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^robots\.txt$ robots.php [L]

    # Zákaz prístupu ku skrytým súborom (.git, .env…) okrem .well-known
    RewriteRule (^|/)\.(?!well-known) - [F,L]
</IfModule>

# Citlivé typy súborov
<FilesMatch "\.(md|log|ini|sql|bak|example|dist|lock|json)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Po zapnutí HTTPS môžete odkomentovať:
    # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Fotky vo formáte JFIF (bežný JPEG s inou príponou) – správny typ, inak ich prehliadač pri „nosniff“ nemusí zobraziť
AddType image/jpeg .jfif

# Kompresia
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/xml image/svg+xml
</IfModule>

# Cache statických súborov (súbory majú ?v= podľa dátumu zmeny, takže dlhá cache je bezpečná)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
